{
  "$schema": "https://json.schemastore.org/electron-builder",
  "appId": "com.tradejournal.app",
  "productName": "Trade Journal",
  "directories": {
    "buildResources": "build",
    "output": "release"
  },
  "files": [
    "out/**/*"
  ],
  "linux": {
    "target": [
      {
        "target": "flatpak",
        "arch": ["x64"]
      },
      {
        "target": "deb",
        "arch": ["x64"]
      }
    ],
    "category": "Finance",
    "maintainer": "Trade Journal",
    "vendor": "Trade Journal"
  },
  "publish": null
}